<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings: resolve every dependency straight from Maven Central.
  Used automatically through .mvn/maven.config, so a developer's global ~/.m2/settings.xml
  (mirrors, proxies, credentials) is neither read nor modified for this project.
  Delete .mvn/maven.config if you prefer your own settings.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <mirrors>
        <mirror>
            <id>maven-central</id>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
</settings>
